# Use uma chave Ollama Cloud apenas localmente, NUNCA suba .env ao GitHub.
# Com esta linha vazia, o aplicativo usa o modo de demonstração (sem LLM).
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b

# Alternativa: Ollama rodando no próprio PC (sem chave):
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Opcional. Padrão: dados/mercador.db
# DATABASE_PATH=dados/mercador.db
